# Copie este arquivo pra ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" de verdade pro GitHub — só este exemplo.

TELEGRAM_BOT_TOKEN=cole_aqui_o_token_que_o_botfather_te_deu

# No seu computador, pode deixar essa linha comentada (usa SQLite local automaticamente).
# No Render, essa variável vai ser preenchida com a URL do Neon.
# DATABASE_URL=postgresql://usuario:senha@endereco-do-neon/nome_do_banco
